# Copy to .env (or set these in the Kubernetes deployment). Never commit real values.
PORT=8001
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<database>
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
STORAGE_SERVICE_URL=http://storagemngservice-srv:8002
USAGE_SERVICE_URL=http://usagemngservice-srv:8003
LOGGING_SERVICE_URL=http://loggingservice-srv:8004/log
# Limits in bytes: 10 MB total storage, 25 MB uploaded per day
STORAGE_LIMIT=10485760
DAILY_USAGE_LIMIT=26214400
